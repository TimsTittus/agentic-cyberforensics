# ==============================================================================
# AgentBruce — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# Type signatures are indicated in comments below for reference.
#
# WARNING: NEVER commit a `.env` file containing actual passwords or secret
# keys to version control. This template contains placeholder values.

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
# POSTGRES_USER: str (PostgreSQL username, used by Docker Postgres container)
POSTGRES_USER=your_postgres_user

# POSTGRES_PASSWORD: str (PostgreSQL password, used by Docker Postgres container)
POSTGRES_PASSWORD=your_postgres_password

# POSTGRES_DB: str (PostgreSQL database name, used by Docker Postgres container)
POSTGRES_DB=agentbruce_db

# DATABASE_URL: connection_uri (Format: postgresql+asyncpg://user:pass@host:port/db)
DATABASE_URL=postgresql+asyncpg://your_postgres_user:your_postgres_password@postgres:5432/agentbruce_db

# ------------------------------------------------------------------------------
# Neo4j Graph Database Settings
# ------------------------------------------------------------------------------
# NEO4J_URI: connection_uri (Format: bolt://host:port or neo4j://host:port)
NEO4J_URI=bolt://neo4j:7687

# NEO4J_USER: str (Neo4j administration username)
NEO4J_USER=neo4j

# NEO4J_PASSWORD: str/SecretStr (Neo4j password)
NEO4J_PASSWORD=your_neo4j_password

# ------------------------------------------------------------------------------
# Qdrant Vector Database Settings
# ------------------------------------------------------------------------------
# Qdrant host/port configurations
# QDRANT_HOST: str (Hostname of the Qdrant service)
QDRANT_HOST=qdrant

# QDRANT_PORT: int (Default: 6333)
QDRANT_PORT=6333

# ------------------------------------------------------------------------------
# Redis Cache & Broker Settings
# ------------------------------------------------------------------------------
# REDIS_URL: connection_uri (Format: redis://[password@]host:port/db_index)
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Security & JWT Token Configurations
# ------------------------------------------------------------------------------
# JWT_SECRET_KEY: SecretStr (Required: cryptographically secure hex key)
# Generate one using: openssl rand -hex 32
JWT_SECRET_KEY=your_cryptographically_secure_jwt_secret_key

# JWT_ALGORITHM: str (Default: HS256)
JWT_ALGORITHM=HS256

# ACCESS_TOKEN_EXPIRE_MINUTES: int (Default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# Forensic Application Settings
# ------------------------------------------------------------------------------
# APP_NAME: str (Default: AgentBruce)
APP_NAME=AgentBruce

# APP_VERSION: str (Default: 0.1.0)
APP_VERSION=0.1.0

# DEBUG: bool (Default: False)
DEBUG=False

# STORAGE_ROOT: path/str (Absolute path inside container for persisted evidence files)
STORAGE_ROOT=/app/storage/evidence